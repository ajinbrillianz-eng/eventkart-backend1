// Prisma schema for eventkart
// Run `npx prisma migrate dev --name init` after setting DATABASE_URL in .env

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Note: SQLite doesn't support native enums, so these are plain strings.
// Role: "CUSTOMER" | "VENDOR" | "ADMIN"
// VendorProfile.status: "PENDING" | "APPROVED" | "REJECTED"
// Requirement.status: "OPEN" | "BOOKED" | "CLOSED"
// Quote.status: "PENDING" | "ACCEPTED" | "REJECTED"
// Booking.status: "PENDING_PAYMENT" | "CONFIRMED" | "COMPLETED" | "CANCELLED" | "DISPUTED"
// Payment.status: "HELD" | "RELEASED" | "REFUNDED"

model User {
  id            Int            @id @default(autoincrement())
  name          String
  email         String         @unique
  password      String
  role          String         @default("CUSTOMER")
  phone         String?
  createdAt     DateTime       @default(now())

  vendorProfile VendorProfile?
  requirements  Requirement[]
  bookings      Booking[]      @relation("CustomerBookings")
  reviews       Review[]
}

model VendorProfile {
  id            Int            @id @default(autoincrement())
  userId        Int            @unique
  user          User           @relation(fields: [userId], references: [id])
  businessName  String
  category      String         // e.g. "wedding", "corporate", "birthday"
  city          String
  description   String?
  status        String         @default("PENDING")
  rating        Float          @default(0)
  reviewCount   Int            @default(0)
  createdAt     DateTime       @default(now())

  packages      Package[]
  quotes        Quote[]
  bookings      Booking[]
}

model Package {
  id          Int           @id @default(autoincrement())
  vendorId    Int
  vendor      VendorProfile @relation(fields: [vendorId], references: [id])
  name        String
  description String?
  price       Float
  createdAt   DateTime      @default(now())
}

model Requirement {
  id             Int                @id @default(autoincrement())
  customerId     Int
  customer       User               @relation(fields: [customerId], references: [id])
  eventType      String             // "wedding" | "corporate" | "birthday" | "other"
  eventDate      DateTime
  city           String
  guestCount     Int?
  budgetMin      Float?
  budgetMax      Float?
  servicesNeeded String?            // comma-separated, e.g. "decor,catering,photography"
  notes          String?
  status         String             @default("OPEN")
  createdAt      DateTime           @default(now())

  quotes         Quote[]
}

model Quote {
  id            Int         @id @default(autoincrement())
  requirementId Int
  requirement   Requirement @relation(fields: [requirementId], references: [id])
  vendorId      Int
  vendor        VendorProfile @relation(fields: [vendorId], references: [id])
  price         Float
  message       String?
  status        String      @default("PENDING")
  createdAt     DateTime    @default(now())

  booking       Booking?
}

model Booking {
  id               Int           @id @default(autoincrement())
  quoteId          Int           @unique
  quote            Quote         @relation(fields: [quoteId], references: [id])
  customerId       Int
  customer         User          @relation("CustomerBookings", fields: [customerId], references: [id])
  vendorId         Int
  vendor           VendorProfile @relation(fields: [vendorId], references: [id])
  totalAmount      Float
  commissionAmount Float
  status           String        @default("PENDING_PAYMENT")
  eventDate        DateTime
  disputeReason    String?
  createdAt        DateTime      @default(now())

  payment          Payment?
  review           Review?
}

model Payment {
  id          Int           @id @default(autoincrement())
  bookingId   Int           @unique
  booking     Booking       @relation(fields: [bookingId], references: [id])
  amountPaid  Float
  status      String        @default("HELD")
  paidAt      DateTime      @default(now())
  releasedAt  DateTime?
}

model Review {
  id         Int      @id @default(autoincrement())
  bookingId  Int      @unique
  booking    Booking  @relation(fields: [bookingId], references: [id])
  customerId Int
  customer   User     @relation(fields: [customerId], references: [id])
  rating     Int      // 1-5
  comment    String?
  createdAt  DateTime @default(now())
}
