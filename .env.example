# Copy this file to .env before running the project

# SQLite for local dev. Swap to a Postgres URL for production, e.g:
# DATABASE_URL="postgresql://user:password@localhost:5432/eventkart"
DATABASE_URL="file:./dev.db"

# Any long random string
JWT_SECRET="replace-this-with-a-long-random-secret"

PORT=4000

# Commission the platform takes on every booking, as a decimal (0.12 = 12%)
COMMISSION_RATE=0.12
